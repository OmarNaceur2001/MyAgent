# Ollama remains the default local provider.
MYAGENT_LLM_PROVIDER=ollama
MYAGENT_OLLAMA_URL=http://127.0.0.1:11434
MYAGENT_MODEL=qwen2.5:3b
MYAGENT_KEEP_ALIVE=2m

# Optional OpenRouter provider.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Optional Groq provider. Llama 3.3 70B Versatile was retired by Groq.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
